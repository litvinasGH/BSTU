<?xml version="1.0"?>

<configuration>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <sessionState mode="InProc" />
  </system.web>

  <system.webServer>
    <handlers>
      <add name="RestHandler"
           path="*.KVV"
           verb="GET,POST,PUT,DELETE"
           type="RestService.RestHandler"
           resourceType="Unspecified" />
    </handlers>
  </system.webServer>

</configuration>
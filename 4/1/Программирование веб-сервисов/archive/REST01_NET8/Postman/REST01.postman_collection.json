{
  "info": {
    "name": "REST01 .NET 8 lab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5088"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 SignIn writer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Results/SignIn",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Results",
            "SignIn"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"login\": \"writer\", \"password\": \"Writer123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set(\"token\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 GET all",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Results",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Results"
          ]
        }
      }
    },
    {
      "name": "3 POST",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Results",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Results"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"value\": \"hello\"}"
        }
      }
    },
    {
      "name": "4 GET by id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Results/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Results",
            "1"
          ]
        }
      }
    },
    {
      "name": "5 PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Results/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Results",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"value\": \"updated\"}"
        }
      }
    },
    {
      "name": "6 DELETE",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/Results/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Results",
            "1"
          ]
        }
      }
    }
  ]
}

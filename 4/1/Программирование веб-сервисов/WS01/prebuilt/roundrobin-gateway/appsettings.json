{
  "ReverseProxy": {
    "Routes": {
      "stackRoute": {
        "ClusterId": "ws01_02_cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "ws01_02_cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "server1": {
            "Address": "http://localhost:5201/"
          },
          "server2": {
            "Address": "http://localhost:5202/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}